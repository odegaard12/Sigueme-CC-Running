[Unit]
Description=la carrera tracker
After=network.target

[Service]
Type=simple
User=USUARIO
WorkingDirectory=/home/USUARIO/sigueme
# ADMIN_USER y ADMIN_HASH (python3 server.py --hash-clave) en un fichero solo para root
EnvironmentFile=/etc/sigueme/secreto.env
# IP flotante de keepalived; sin ella, una sola máquina (siempre la activa)
Environment=VIP_SIGUEME=IP_FLOTANTE
ExecStart=/usr/bin/python3 /home/USUARIO/sigueme/server.py 8710
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
