<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- saber cuándo vuelve la cobertura para vaciar la cola al momento -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- para saber si está la app de la pulsera (Android 11+ no deja ver otras apps sin esto) -->
    <queries>
        <package android:name="com.huami.watch.hmwatchmanager" />
        <package android:name="com.xiaomi.wearable" />
        <package android:name="com.mi.health" />
        <package android:name="com.xiaomi.hm.health" />
        <package android:name="nodomain.freeyourgadget.gadgetbridge" />
        <package android:name="com.huawei.health" />
    </queries>

    <application
        android:label="Sígueme CC"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- configuración desde el QR del panel (vía /app.html) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="siguemecc" android:host="config" />
            </intent-filter>
        </activity>

        <service android:name=".Seguimiento" android:exported="false" android:foregroundServiceType="location" />
    </application>
</manifest>
